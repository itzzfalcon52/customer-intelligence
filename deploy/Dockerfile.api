# FastAPI and the training/monitoring worker share one container because they share /data.
FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
# libgomp1: OpenMP runtime for XGBoost. tini: forwards signals to both processes.
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 tini \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY apps/api/requirements.txt .
RUN pip install --require-hashes -r requirements.txt
COPY apps/api/pyproject.toml apps/api/README.md* ./
COPY apps/api/src ./src
RUN pip install --no-deps .
COPY deploy/api-entrypoint.sh /usr/local/bin/api-entrypoint
RUN chmod +x /usr/local/bin/api-entrypoint \
    && useradd --create-home --uid 10001 app && mkdir -p /data && chown app /data
USER app
ENV CI_DATA_DIRECTORY=/data CI_ENVIRONMENT=production CI_AUTH_MODE=account \
    CI_AUTH_SERVICE_URL=http://backend:3001
EXPOSE 8000
ENTRYPOINT ["tini", "--", "api-entrypoint"]
