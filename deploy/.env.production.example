# Copy to deploy/.env on the server (never commit it). Placeholders only.
DOMAIN=app.example.com

# Neon (same project as development, or a separate production branch). Keep sslmode=require.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DIRECT_DATABASE_URL=

# Generate each with: openssl rand -hex 32
BETTER_AUTH_SECRET=
INTERNAL_API_SECRET=

# Nebius AI (Nemotron)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning

# Connectors: encrypts stored Razorpay/Zoho/Stripe/HubSpot credentials. Generate once and keep it
# (changing it makes saved connections unreadable):
#   openssl rand -base64 32 | tr '+/' '-_'
CI_CREDENTIALS_KEY=

# Email digests through Resend (optional; both needed). Sender on a domain verified in Resend.
CI_RESEND_API_KEY=
CI_EMAIL_FROM=

# Upload limits and training time budget
CI_MAX_UPLOAD_MB=200
CI_MAX_ROWS=1000000
CI_WORKER_TIMEOUT_SECONDS=1800

# Backups (optional): any S3-compatible bucket, e.g. Cloudflare R2 or AWS S3
BACKUP_BUCKET=
BACKUP_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
