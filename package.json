{
  "name": "customer-intelligence",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @ci/web dev",
    "dev:api": "pnpm --filter @ci/api dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup:python": "node scripts/setup-python.mjs",
    "worker:api": "pnpm --filter @ci/api worker",
    "test:api": "pnpm --filter @ci/api test",
    "dev:backend": "pnpm --filter @ci/backend dev",
    "setup:backend": "node scripts/setup-backend.mjs",
    "setup:connectors": "node scripts/setup-connectors.mjs",
    "test:backend": "pnpm --filter @ci/backend test",
    "eval:agent": "pnpm --filter @ci/api eval",
    "eval:agent:live": "pnpm --filter @ci/api eval:live",
    "eval:agent:record": "pnpm --filter @ci/api eval:record"
  },
  "devDependencies": {
    "turbo": "2.11.7",
    "prettier": "^3.6.2"
  }
}
