  "narrative": {
    "northStar": "The Triage Board",
    "overview": "Holdfast treats every customer account as a paper triage tag hung on a wire. The tag carries a coloured bar (red to call first, amber to watch, slate for lower risk), a stamped rank and score, ruled lines for the reasons, and a grommet where it hangs. The marketing site (a Persuade surface) shows the board itself: a teal field ground, tag-stock objects tilting on wires, strips of tags and stamps moving past, and passages that alternate between field, stock and the deepest field-950.\n\nThe workspace (an Operate surface) inherits the same materials with restraint. The deep field becomes the sidebar, tag stock becomes the canvas, condensed Archivo carries page titles, measured numbers are stamped in Martian Mono, and risk is only ever red, amber or slate. It stays calm and dense: there are no hanging-tag tilts or moving strips inside the app. The world shows up as tag-cut primary buttons, a red hanging tab on the active nav item, triage swatches beside ranks and the tag silhouette on the daily brief.\n\nVisual rejections: generic SaaS gradients, glass, purple accents, green for \"good risk\", and rounded pill buttons.",
    "keyCharacteristics": [
      "Teal field, tag stock and steel wire as the only materials.",
      "Three triage colours carry risk, always next to a text label.",
      "One width axis (Archivo 62–125%) expresses the role of each piece of text.",
      "Numbers are stamped, never set in the reading face.",
      "Loops pause off-screen and show their finished state under reduced motion."
    ],
    "rules": [
      {
        "name": "The Never-Green Rule",
        "body": "Risk levels are red, amber or slate. Green never means \"safe\".",
        "section": "colors"
      },
      {
        "name": "The Amber Emphasis Rule",
        "body": "Amber marks one word per display heading, selection, focus on dark ground and small counts on dark ground. It is never a large fill except the marketing \"Coming soon\" band.",
        "section": "colors"
      },
      {
        "name": "The Width Axis Rule",
        "body": "Width encodes role: 62–70% for display, 74–82% for titles, 86–88% for names and the wordmark, 100% for reading text. Word spacing on condensed heads is 0.08–0.09em.",
        "section": "typography"
      },
      {
        "name": "The Stamp for Numbers Rule",
        "body": "Every measured number (rank, score, count, metric) is set in the stamp font with tabular figures.",
        "section": "typography"
      },
      {
        "name": "The Tag Shadow Only Rule",
        "body": "Large lifted shadows belong to tag stock. Panels stay flat.",
        "section": "elevation"
      },
      {
        "name": "The Metal-Only Gradients Rule",
        "body": "Gradients appear only as metal: rails, clips and sheen. There are no colour washes and no gradient text.",
        "section": "elevation"
      },
      {
        "name": "The Tag Silhouette Rule",
        "body": "A tag is the cut-corner shape, a grommet, a coloured bar and ruled stock. Use it for objects that represent an account or a decision, not for every card.",
        "section": "shapes"
      }
    ],
    "dos": [
      "Do show risk as red, amber or slate, always with a text label beside the colour.",
      "Do set ranks, scores and stat values in Martian Mono with tabular figures.",
      "Do use condensed Archivo (66–68% width) at weight 820–860 for page and section heads.",
      "Do keep text greys at Quiet (#687370) or darker on stock and white.",
      "Do let every attract loop pause off-screen and settle complete under reduced motion."
    ],
    "donts": [
      "Don't use green to mean low risk or success in risk contexts.",
      "Don't put hanging-tag tilts, sway or moving strips inside the workspace.",
      "Don't use side-stripe borders on cards or rows; mark triage with the tag swatch.",
      "Don't use pill-shaped buttons, gradient text or colour-wash backgrounds.",
      "Don't put large lifted shadows on panels; they belong to tags."
    ]
  }
