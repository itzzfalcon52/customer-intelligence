# Copy the pooled connection string from your Neon project. Keep sslmode=require.
DATABASE_URL=
# Optional: Neon direct connection string for migrations.
DIRECT_DATABASE_URL=
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# Use this exact hostname in your browser during local development.
APP_ORIGIN=http://127.0.0.1:5173
PORT=3001
NODE_ENV=development

# Private bridge to Python; never a VITE variable.
INTERNAL_API_SECRET=
