{
  "name": "@ci/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "check-types": "prisma generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.7",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "pg": "8.16.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "^22.18.0",
    "@types/pg": "8.15.5",
    "prisma": "7.10.0",
    "tsx": "4.20.6",
    "typescript": "~5.9.3"
  }
}
