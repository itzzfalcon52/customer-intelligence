# Add these to apps/api/.env; do not commit credentials.
# Keep the base URL/model ID verified in your Nebius account.
NEBIUS_API_KEY=replace-with-your-key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning

# Optional local controls; remove comment markers to override defaults.
# CI_ENVIRONMENT=development
# CI_DATA_DIRECTORY=/absolute/path/to/private/data
# CI_WORKER_TIMEOUT_SECONDS=600
# CI_API_TOKEN=replace-with-a-long-random-private-token
# CI_ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]"]
