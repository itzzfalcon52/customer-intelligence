# Add these to apps/api/.env; do not commit credentials.
# Keep the base URL/model ID verified in your Nebius account.
NEBIUS_API_KEY=replace-with-your-key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
# Optional cheaper model for tool selection; the primary model still writes answers.
# NEBIUS_FAST_MODEL=verified-model-id-from-your-account

# Optional local controls; remove comment markers to override defaults.
# CI_ENVIRONMENT=development
# CI_DATA_DIRECTORY=/absolute/path/to/private/data
# CI_WORKER_TIMEOUT_SECONDS=1800
# Upload limits (defaults shown). Bigger files cost time, RAM and disk, not AI credits.
# CI_MAX_UPLOAD_MB=200
# CI_MAX_ROWS=1000000
# CI_MAX_COLUMNS=500
# CI_MAX_EXCEL_MB=50
# CI_API_TOKEN=replace-with-a-long-random-private-token
# CI_ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]"]

# Browser app uses server-validated Better Auth sessions.
CI_AUTH_MODE=account
# INTERNAL_API_SECRET is read from apps/backend/.env.

# Provider requests are bounded. Set trust-env only when you intentionally use a proxy.
CI_NEBIUS_TIMEOUT_SECONDS=60
CI_NEBIUS_TRUST_ENV=false
# Verified control for nvidia/Nemotron-3_5-Lightning; keeps tool results concise.
CI_NEBIUS_ENABLE_THINKING=false
# Retries apply only to timeouts, connection errors, 429 and 5xx (0-3).
CI_NEBIUS_MAX_RETRIES=1
# Optional USD prices per million input/output tokens; costs stay unknown without them.
# CI_MODEL_PRICES={"model-id":[0.0,0.0]}

# Encrypts Stripe/HubSpot connector credentials (connectors are disabled without it).
# CI_CREDENTIALS_KEY=replace-with-a-fernet-key   (pnpm setup:connectors writes this for you)

# Email digests through Resend (both needed; email stays off without them).
# The sender must be on a domain you verified in Resend.
# CI_RESEND_API_KEY=re_replace_me
# CI_EMAIL_FROM=Holdfast <brief@yourdomain.com>
